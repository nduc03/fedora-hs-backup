tls:
  options:
      dot-options:
        alpnProtocols:
          - "dot"
http:
  serversTransports:
    skip-tls:
      insecureSkipVerify: true

  # system or external services
  routers:
    ont:
      rule: "Host(`ont.$PUBLIC_DOMAIN`)"
      service: ont
      entryPoints:
        - websecure
      tls:
        certResolver: leresolver

    filebrowser:
      rule: "Host(`file.$PUBLIC_DOMAIN`)"
      service: filebrowser
      entryPoints:
        - websecure
      tls:
        certResolver: leresolver

    dns-le:
      rule: "Host(`dns.$PUBLIC_DOMAIN`)"
      service: dns-le
      entryPoints:
        - websecure
      tls:
        certResolver: leresolver

  services:
    ont:
      loadBalancer:
        serversTransport: skip-tls
        servers:
          - url: "https://192.168.1.1/"

    filebrowser:
      loadBalancer:
        servers:
          - url: "http://host.containers.internal:9000/"

    cockpit:
      loadBalancer:
        serversTransport: skip-tls
        servers:
          - url: "https://host.containers.internal:9090/"

    dns-le:
      loadBalancer:
        servers:
          - url: "http://adguard-home:80/"

tcp:
  routers:
    dns-le-dot:
      rule: "HostSNI(`dns.$PUBLIC_DOMAIN`)"
      entryPoints:
        - dns-over-tls
      service: dns-le-dot
      tls:
        certResolver: leresolver
        options: "dot-options"
  services:
    dns-le-dot:
      loadBalancer:
        servers:
          - address: "adguard-home:53"