[Unit]
Description=Traefik reverse proxy
After=network-online.target

[Container]
Image=docker.io/library/traefik:v3.7
ContainerName=traefik
Network=traefik.network

Label=traefik.enable=true
Label=traefik.http.routers.dashboard.rule=Host(`traefik.hs.lan`)
Label=traefik.http.routers.dashboard.entrypoints=websecure
Label=traefik.http.routers.dashboard.service=api@internal
Label=traefik.http.routers.dashboard.tls=true
Label=traefik.http.middlewares.dashboard-auth.basicauth.users=$DASHBOARD_AUTH_CRED
Label=traefik.http.routers.dashboard.middlewares=dashboard-auth@docker

PublishPort=$HOST_IPV4:80:80
PublishPort=$HOST_ULA_IPV6:80:80
PublishPort=$HOST_IPV4:443:443/tcp
PublishPort=$HOST_IPV4:443:443/udp
PublishPort=$HOST_ULA_IPV6:443:443/tcp
PublishPort=$HOST_ULA_IPV6:443:443/udp

PublishPort=853:853/tcp

Volume=/run/user/1000/podman/podman.sock:/var/run/docker.sock:Z,ro
Volume=/etc/localtime:/etc/localtime:ro
Volume=$SERVICE_DATA_DIR/dynamic:/dynamic:Z,ro
Volume=$SERVICE_DATA_DIR/etc/traefik:/etc/traefik:Z
Volume=$SERVICE_DATA_DIR/mycerts:/mycerts:Z,ro
EnvironmentFile=$SERVICE_DIR/secrets/token.env

[Service]
Restart=always

[Install]
WantedBy=default.target