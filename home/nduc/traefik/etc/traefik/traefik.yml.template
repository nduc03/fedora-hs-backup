global:
  checkNewVersion: false
  sendAnonymousUsage: false

log:
  level: INFO
accessLog: {}

api:
  dashboard: true
  insecure: false

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true

  websecure:
    address: ":443"
    asDefault: true
    http:
      tls: {}
    http3: {}

  dns-over-tls:
    address: ":853"

providers:
  docker:
    exposedByDefault: false
    defaultRule: "Host(`{{ index .Labels \"host.subdomain\" | default .Name }}.$PRIVATE_DOMAIN`)"
  file:
    directory: "/dynamic"
    watch: true

certificatesResolvers:
  leresolver:
    acme:
      email: inform@$PUBLIC_DOMAIN
      storage: /etc/traefik/acme.json
      dnsChallenge:
        provider: cloudflare
        resolvers:
          - "198.18.8.8:53"