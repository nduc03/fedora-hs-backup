# Firefly III Environment Variables

# APP_KEY must be exactly 32 alphanumeric characters
# When installing via install.sh, this key is generated automatically if fireflyiii.env does not exist.
APP_KEY=CHANGEME_32_CHARS

# Database Configuration (PostgreSQL on host)
DB_CONNECTION=pgsql
DB_HOST=host.containers.internal
DB_PORT=5432
DB_DATABASE=fireflyiii
DB_USERNAME=postgres
DB_PASSWORD=CHANGEME
